        <mxCell id="target6" value="&lt;b&gt;CORP_DRIVER.DriverNo&lt;/b&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8293A3;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="835" width="360" height="48" as="geometry" />
        </mxCell>
        <mxCell id="fk6" value="FK" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#BB5A42;fontSize=10;" edge="1" parent="1" source="col11" target="target6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="table_rules" value="&lt;b&gt;Table / cross-row rules&lt;/b&gt;&lt;br&gt;Composite FK (MainCorpCustomerNo, MainDriverNo) references CORP_DRIVER(CustomerNo, DriverNo); both are NULL together or populated together. Exactly one of CategoryRateID / ModelRateID is used; corporate rentals name an authorized driver. ExpectedReturnDT &amp;gt; PickupDT; ActualReturnDT IS NULL OR ActualReturnDT &amp;gt; PickupDT; ReturnOdometer IS NULL OR ReturnOdometer &amp;gt;= PickupOdometer; Main driver must be that corporate customer’s authorized driver. ReservationNo unique means one rental at most per reservation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D6A500;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="345" width="1500" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
