          <mxGeometry x="35" y="355" width="360" height="48" as="geometry" />
        </mxCell>
        <mxCell id="fk0" value="FK" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#BB5A42;fontSize=10;" edge="1" parent="1" source="col0" target="target0">
          <mxGeometry relative="1" as="geometry" />
