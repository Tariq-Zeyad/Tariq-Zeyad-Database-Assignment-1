  <diagram name="0-Contents" id="page62">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;DriveNow Database Design — Contents &amp;amp; Navigation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#16324F;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="2540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="owner" value="Tariq Zeyad Khashan | Group: 1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#526579;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="2540" height="26" as="geometry" />
        </mxCell>
        <mxCell id="intro" value="&lt;b&gt;How to use this file&lt;/b&gt;&lt;br&gt;Start here, then follow the numbered sections. The five schema overview pages show related tables and fields. Numbered schema pages show one table at a time with horizontal column boxes and FK endpoints. ERD pages use Chen entities, attributes, relationship diamonds, cardinality labels, and participation labels." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;fontSize=14;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="115" width="2500" height="105" as="geometry" />
        </mxCell>
        <mxCell id="contents_a" value="&lt;b&gt;PART A — CHEN ERD&lt;/b&gt;&lt;br&gt;• 1-ERD-1-Staff — BRANCH, EMPLOYEE, AGENT, MECHANIC, COURSE, TRAINING_ATTEMPT, BRANCH_MANAGER_ASSIGNMENT&lt;br&gt;• 1-ERD-2-Fleet — CATEGORY, CATEGORY_RATE, CAR_MODEL, VEHICLE, VEHICLE_STATUS_HISTORY, GPS_DEVICE, DEVICE_INSTALLATION, TRANSFER, MODEL_RATE&lt;br&gt;• 1-ERD-3-Customer — CUSTOMER, INDIVIDUAL, CORPORATE, CORP_DRIVER, BLACKLIST, CORPORATE_CATEGORY_DISCOUNT&lt;br&gt;• 1-ERD-4-Reservations — RESERVATION, PROMOTION&lt;br&gt;• 1-ERD-5-Rentals — RENTAL, RENTAL_DRIVER, RENTAL_EXTRA, EXTRA, INSURANCE_PACKAGE, RENTAL_INSURANCE, RENTAL_DRIVER&lt;br&gt;• 1-ERD-6-Operations — DAMAGE_REPORT, VIOLATION, FEEDBACK, JOB_CARD, JOB_MECHANIC, PART, JOB_PART, SUPPLIER, SUPPLIER_PART&lt;br&gt;• 1-ERD-7-Payments-Loyalty — PAYMENT, CORP_INVOICE, INVOICE_RENTAL, LOYALTY_ENTRY, CATEGORY_RATE, EXTRA&lt;br&gt;&lt;br&gt;&lt;b&gt;PART C — QUESTIONS &amp; DESIGN NOTES&lt;/b&gt;&lt;br&gt;• 3-Questions-Assumptions — open questions, assumptions, and SRS gaps/contradictions&lt;br&gt;&lt;br&gt;&lt;b&gt;PART D — BUSINESS RULES&lt;/b&gt;&lt;br&gt;• 4-Business-Rules — constraints that require transaction or application logic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FB;strokeColor=#2874A6;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="250" width="1040" height="1450" as="geometry" />
        </mxCell>
        <mxCell id="contents_b" value="&lt;b&gt;PART B — RELATIONAL SCHEMA OVERVIEWS&lt;/b&gt;&lt;br&gt;• 2-Schema-Overview-1-Staff — Organization &amp; Training&lt;br&gt;• 2-Schema-Overview-2-Fleet — Fleet &amp; Tracking&lt;br&gt;• 2-Schema-Overview-3-Customers — Customers &amp; Reservations&lt;br&gt;• 2-Schema-Overview-4-Rentals — Rentals &amp; Customer Operations&lt;br&gt;• 2-Schema-Overview-5-Workshop-Finance — Workshop, Billing &amp; Loyalty&lt;br&gt;&lt;br&gt;&lt;b&gt;DETAILED TABLE PAGES (one table per page)&lt;/b&gt;&lt;br&gt;• 2-Schema-1 — BRANCH&lt;br&gt;• 2-Schema-2 — BRANCH_PHONE&lt;br&gt;• 2-Schema-3 — EMPLOYEE&lt;br&gt;• 2-Schema-4 — AGENT&lt;br&gt;• 2-Schema-5 — MECHANIC&lt;br&gt;• 2-Schema-6 — COURSE&lt;br&gt;• 2-Schema-7 — TRAINING_ATTEMPT&lt;br&gt;• 2-Schema-8 — CATEGORY&lt;br&gt;• 2-Schema-9 — CATEGORY_RATE&lt;br&gt;• 2-Schema-10 — CAR_MODEL&lt;br&gt;• 2-Schema-11 — VEHICLE&lt;br&gt;• 2-Schema-12 — VEHICLE_STATUS_HISTORY&lt;br&gt;• 2-Schema-13 — GPS_DEVICE&lt;br&gt;• 2-Schema-14 — DEVICE_INSTALLATION&lt;br&gt;• 2-Schema-15 — TRANSFER&lt;br&gt;• 2-Schema-16 — CUSTOMER&lt;br&gt;• 2-Schema-17 — CUSTOMER_PHONE&lt;br&gt;• 2-Schema-18 — INDIVIDUAL&lt;br&gt;• 2-Schema-19 — CORPORATE&lt;br&gt;• 2-Schema-20 — CORP_DRIVER&lt;br&gt;• 2-Schema-21 — BLACKLIST&lt;br&gt;• 2-Schema-22 — RESERVATION&lt;br&gt;• 2-Schema-23 — RENTAL (part 1/2)&lt;br&gt;• 2-Schema-24 — RENTAL (part 2/2)&lt;br&gt;• 2-Schema-25 — RENTAL_DRIVER&lt;br&gt;• 2-Schema-26 — EXTRA&lt;br&gt;• 2-Schema-27 — RENTAL_EXTRA&lt;br&gt;• 2-Schema-28 — PROMOTION&lt;br&gt;• 2-Schema-29 — INSURANCE_PACKAGE&lt;br&gt;• 2-Schema-30 — RENTAL_INSURANCE&lt;br&gt;• 2-Schema-31 — DAMAGE_REPORT&lt;br&gt;• 2-Schema-32 — DAMAGE_PHOTO&lt;br&gt;• 2-Schema-33 — VIOLATION&lt;br&gt;• 2-Schema-34 — FEEDBACK&lt;br&gt;• 2-Schema-35 — JOB_CARD&lt;br&gt;• 2-Schema-36 — JOB_MECHANIC&lt;br&gt;• 2-Schema-37 — PART&lt;br&gt;• 2-Schema-38 — JOB_PART&lt;br&gt;• 2-Schema-39 — SUPPLIER&lt;br&gt;• 2-Schema-40 — SUPPLIER_PART&lt;br&gt;• 2-Schema-41 — PAYMENT&lt;br&gt;• 2-Schema-42 — CORP_INVOICE&lt;br&gt;• 2-Schema-43 — INVOICE_RENTAL&lt;br&gt;• 2-Schema-44 — LOYALTY_ENTRY&lt;br&gt;• 2-Schema-45 — BRANCH_MANAGER_ASSIGNMENT&lt;br&gt;• 2-Schema-46 — MODEL_RATE&lt;br&gt;• 2-Schema-47 — CORPORATE_CATEGORY_DISCOUNT&lt;br&gt;&lt;br&gt;&lt;b&gt;CHEN LEGEND&lt;/b&gt;&lt;br&gt;• Rectangle: strong entity; double rectangle: weak entity&lt;br&gt;• Diamond: relationship; double diamond: identifying relationship&lt;br&gt;• Oval: attribute; underlined: key; composite attribute has child ovals&lt;br&gt;• Double oval: multivalued attribute; dashed oval: derived attribute&lt;br&gt;• Relationship line labels show 1 / N / M and total / partial participation&lt;br&gt;• Dashed entity boxes are references to entities defined on another ERD page" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FB;strokeColor=#2874A6;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1110" y="250" width="1425" height="1740" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
