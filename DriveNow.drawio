          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="target1" value="&lt;b&gt;EMPLOYEE.EmployeeID&lt;/b&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8293A3;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="435" width="360" height="48" as="geometry" />
        </mxCell>
        <mxCell id="fk1" value="FK" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#BB5A42;fontSize=10;" edge="1" parent="1" source="col1" target="target1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="table_rules" value="&lt;b&gt;Table / cross-row rules&lt;/b&gt;&lt;br&gt;PK(BranchCode, EmployeeID, StartDate). Only one open assignment per branch and per manager; temporal overlap excluded by transaction/trigger. Branch continuously has an active manager." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D6A500;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="345" width="1430" height="65" as="geometry" />
